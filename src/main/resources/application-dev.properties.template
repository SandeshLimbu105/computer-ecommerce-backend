# =============================================
# DEVELOPMENT CONFIGURATION TEMPLATE
# =============================================
# 📝 INSTRUCTIONS:
# 1. Copy this file to: application-dev.properties
# 2. Fill in your actual credentials
# 3. NEVER commit application-dev.properties to GitHub!
# 4. This template file IS safe to commit

# ===== SERVER CONFIGURATION =====
server.port=8080

# ===== DATABASE CONFIGURATION =====
# TODO: Replace with your database credentials
spring.datasource.url=jdbc:mysql://localhost:3306/your_database_name
spring.datasource.username=root
spring.datasource.password=root123
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===== JPA & HIBERNATE =====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ===== JWT CONFIGURATION =====
jwt.secret=your_jwt_secret_key_minimum_32_characters_long
jwt.expiration=86400000

# ===== ESEWA PAYMENT CONFIGURATION =====
esewa.sandbox.url=https://rc-epay.esewa.com.np/api/epay/main/v2/form
esewa.merchant.code=EPAYTEST
esewa.secret.key=your_esewa_secret_key
esewa.success.url=http://localhost:8080/api/payments/esewa/success
esewa.failure.url=http://localhost:8080/api/payments/esewa/failure

# ===== FRONTEND URL =====
frontend.base.url=http://localhost:5173

# ===== LOGGING =====
logging.level.org.texas.computerecommerce=DEBUG
logging.level.org.springframework.security=DEBUG